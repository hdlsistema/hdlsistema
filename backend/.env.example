# ────────────────────────────────────────────────────────────
# Hacienda de Letras API — Variables de entorno (plantilla)
# Copiar a .env y completar con valores reales.
# NUNCA subir .env al repositorio.
# ────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=3001

# CORS — orígenes autorizados separados por coma
FRONTEND_URL=http://localhost:5173
PUBLIC_ACCESS_BASE_URL=https://admhaciendadeletras.com/acceso
ALLOWED_ORIGINS=http://localhost:5173,https://admhaciendadeletras.com,https://www.admhaciendadeletras.com

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — reservado, integración futura del lado servidor
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Resend — emails transaccionales, solo lado servidor
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO_EMAIL=
RESEND_WEBHOOK_SECRET=

# Stripe — pagos con PaymentIntent, solo lado servidor
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ACCOUNT_ID=
STRIPE_ENVIRONMENT=test
