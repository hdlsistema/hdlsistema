{
  "name": "hacienda-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "vite",
    "dev:mobile": "vite --config vite.mobile.config.ts --host 127.0.0.1",
    "build": "npm run build:web",
    "build:web": "tsc -b && vite build",
    "build:mobile": "tsc -b && vite build --config vite.mobile.config.ts",
    "android:sync": "npm run build:mobile && npx cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "lint": "oxlint",
    "preview": "npm run preview:web",
    "preview:web": "vite preview",
    "preview:mobile": "vite preview --config vite.mobile.config.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/push-notifications": "^8.1.2",
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.13.0",
    "@supabase/supabase-js": "^2.111.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/qrcode": "^1.5.6",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.22.0",
    "mapbox-gl": "^3.25.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^2.0.0"
  }
}
